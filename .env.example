# ==============================================================================
# Plantilla de Configuración - bsky-media-scrobbler
# Copia este archivo como .env y rellena con tus credenciales
# ==============================================================================

# Modo Simulación (true: simula posts en los logs sin publicar en Bluesky; false: publicación real)
DRY_RUN=false

# Proveedor de seguimiento: 'wetrakr' o 'simkl'
TRACKER_PROVIDER=wetrakr

# Configuración de WeTrakr (Requerido si TRACKER_PROVIDER=wetrakr)
WETRAKR_CLIENT_ID=tu_client_id_de_wetrakr
WETRAKR_CLIENT_SECRET=tu_client_secret_de_wetrakr
WETRAKR_ACCESS_TOKEN=tu_access_token_o_dejar_vacio_para_pin_flow

# Configuración de SIMKL (Requerido si TRACKER_PROVIDER=simkl)
SIMKL_CLIENT_ID=tu_simkl_client_id
SIMKL_USER_TOKEN=tu_simkl_user_token_o_dejar_vacio_para_pin_flow

# API Key de TheTVDB v4 para traducir títulos de series y películas al español (BSKY_LANG=es/ca)
TVDB_API_KEY=tu_tvdb_api_key_aqui

# Credenciales de Bluesky (Usa siempre una App Password desde Ajustes > Contraseñas de aplicación)
BSKY_HANDLE=tu_cuenta.bsky.social
BSKY_APP_PASSWORD=tu_app_password_aqui
BSKY_LANG=es

# Intervalo de comprobación en minutos (por defecto 90 para agrupar maratones)
POLL_INTERVAL_MINUTES=90

# Control de ráfagas y límite de seguridad contra spam en Bluesky
MAX_POSTS_PER_RUN=6
POST_DELAY_SECONDS=5

# Enlace de las fichas externas: tmdb (recomendado), wetrakr, simkl o imdb
LINK_DESTINATION=tmdb

# Zona horaria (para ajustar frases de madrugada, sobremesa, días y resúmenes)
TZ=Europe/Madrid
